import java.util.Scanner;

class Vehicle {
    String company;
    double price;

    void accept(Scanner sc) {
        System.out.print("Enter company: ");
        company = sc.next();
        System.out.print("Enter price: ");
        price = sc.nextDouble();
    }

    void display() {
        System.out.println("Company: " + company + ", Price: " + price);
    }
}

class LightMotorVehicle extends Vehicle {
    double mileage;

    void accept(Scanner sc) {
        super.accept(sc);
        System.out.print("Enter mileage: ");
        mileage = sc.nextDouble();
    }

    void display() {
        System.out.println("Type: Light Motor Vehicle");
        super.display();
        System.out.println("Mileage: " + mileage + " km/l");
    }
}

class HeavyMotorVehicle extends Vehicle {
    double capacity;

    void accept(Scanner sc) {
        super.accept(sc);
        System.out.print("Enter capacity in tons: ");
        capacity = sc.nextDouble();
    }

    void display() {
        System.out.println("Type: Heavy Motor Vehicle");
        super.display();
        System.out.println("Capacity: " + capacity + " tons");
    }
}

public class Q7_Vehicle {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("How many vehicles? ");
        int n = sc.nextInt();

        Vehicle[] v = new Vehicle[n];
        for (int i = 0; i < n; i++) {
            System.out.println("--- Vehicle " + (i + 1) + " ---");
            System.out.print("Type? 1 = Light, 2 = Heavy: ");
            int type = sc.nextInt();

            if (type == 1) {
                v[i] = new LightMotorVehicle();
            } else {
                v[i] = new HeavyMotorVehicle();
            }
            v[i].accept(sc);
        }

        System.out.println("\n===== Vehicle Details =====");
        for (int i = 0; i < n; i++) {
            v[i].display();
            System.out.println();
        }
    }
}