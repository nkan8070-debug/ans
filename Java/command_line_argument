public class Q10_CommandLine {
    public static void main(String[] args) {
        if (args.length < 2) {
            System.out.println("Please give two numbers. Example: java Q10_CommandLine 10 20");
            return;
        }

        int a = Integer.parseInt(args[0]);
        int b = Integer.parseInt(args[1]);

        System.out.println("Sum = " + (a + b));
    }
}