class Circle {
    double radius;

    Circle(double radius) {
        this.radius = radius;
    }

    double area() {
        return 3.14159 * radius * radius;
    }
}

class Cylinder extends Circle {
    double height;

    Cylinder(double radius, double height) {
        super(radius);                  // call Circle constructor
        this.height = height;
    }

    double area() {
        // 2 * (base circle area) + side area
        return 2 * super.area() + 2 * 3.14159 * radius * height;
    }
}

public class Q8_CylinderSuper {
    public static void main(String[] args) {
        Circle c = new Circle(5);
        Cylinder cy = new Cylinder(5, 10);

        System.out.println("Area of Circle = " + c.area());
        System.out.println("Area of Cylinder = " + cy.area());
    }
}